#!/usr/bin/env python3
"""Scan nearby Wi-Fi networks, best first.

Asks the WiFi Rank app to do the scan (`--json`), because macOS hides network
names from plain command-line tools and the app holds the location permission.
Falls back to system_profiler (names redacted) if the app isn't installed.
"""
import json, os, re, subprocess, sys

APP = next((a for a in (os.path.expanduser("~/Applications/WiFi Rank.app/Contents/MacOS/wifirank"),
                        "/Applications/WiFi Rank.app/Contents/MacOS/wifirank") if os.access(a, os.X_OK)), None)


def via_app():
    # stderr is left attached so messages such as "click Allow" reach the terminal.
    p = subprocess.run([APP, "--json"], stdout=subprocess.PIPE, text=True, timeout=120)
    rows = json.loads(p.stdout or "[]")
    return [dict(ssid=r["ssid"], sig=r["rssi"], bssid=r["bssid"],
                 snr=r["rssi"] - r["noise"] if r["noise"] else None,
                 ch=str(r["channel"]), band=r["band"], sec=r["security"],
                 cur=r["current"]) for r in rows]


def via_profiler():
    raw = subprocess.run(["system_profiler", "-json", "SPAirPortDataType"],
                         capture_output=True, text=True).stdout
    ifaces = json.loads(raw)["SPAirPortDataType"][0]["spairport_airport_interfaces"]
    out = []
    for iface in ifaces:
        nets = [(iface.get("spairport_current_network_information"), True)]
        nets += [(n, False) for n in
                 iface.get("spairport_airport_other_local_wireless_networks", [])]
        for net, cur in nets:
            if not net or not net.get("spairport_signal_noise"):
                continue
            sig, noise = (re.findall(r"(-?\d+) dBm", net["spairport_signal_noise"]) + [None])[:2]
            ch = net.get("spairport_network_channel", "")
            # Apple ships one value with a typo ("pairport_..."), so strip loosely.
            sec = re.sub(r"^s?pairport_security_mode_", "", net.get("spairport_security_mode", ""))
            out.append(dict(
                ssid=net.get("_name", "?"), sig=int(sig), bssid="",
                snr=int(sig) - int(noise) if noise else None,
                ch=ch.split(" ")[0],
                band="5G" if "5GHz" in ch else "6G" if "6GHz" in ch else "2.4G" if "2GHz" in ch else "?",
                sec={"none": "open", "": "?"}.get(sec, sec.replace("_", " ")), cur=cur))
    return out


show_bssid = "--bssid" in sys.argv
try:
    nets = via_app() if APP else via_profiler()
except Exception as e:
    sys.exit(f"Scan failed: {e}")

if not nets:
    sys.exit("No networks found. Is Wi-Fi on?")


def family(ssid):
    """Network name with any band marker removed, so Foo and Foo_5G match."""
    s = re.sub(BAND, "", ssid.lower())
    return re.sub(r"[-_ ]+", "_", s).strip("_")


def best_first(r):
    """Highest SNR first; stronger signal breaks ties. Same order as WiFi Rank."""
    return (-(r["snr"] if r["snr"] is not None else -999), -r["sig"])


BAND = r"[-_ ]?(2\.4|2|5|6)\s*g(hz)?\b"


def same_box(x, y):
    """Radios in one box share the 4th and 5th address bytes and have last bytes
    close together (…:b2/…:b3). Separate boxes jump further (…:ac/…:75)."""
    bx, by = x.split(":"), y.split(":")
    return len(bx) == len(by) == 6 and bx[3:5] == by[3:5] and abs(int(bx[5], 16) - int(by[5], 16)) <= 16


def base_name(ssid):
    """Network name with any band marker removed, keeping its capitals."""
    return re.sub(BAND, "", ssid, flags=re.I).strip(" _-") or ssid


def render(rows, indent=""):
    for n in rows:
        bar = "▂▄▆█"[min(3, max(0, (n["sig"] + 90) // 12))]
        snr = n["snr"] if n["snr"] is not None else "-"
        col = f"{n['bssid']:<18}" if show_bssid else ""
        print(f"{'*' if n['cur'] else ' '} {indent}{n['ssid'][:28 - len(indent)]:<{28 - len(indent)}} "
              f"{snr:>4} {n['sig']:>5} {n['ch']:>4} {n['band']:<5} {bar} {col}{n['sec']}")


head = f"{'BSSID':<18}" if show_bssid else ""
print(f"  {'SSID':<28} {'SNR':>4} {'dBm':>5} {'CH':>4} {'BAND':<5}   {head}SECURITY")

if not show_bssid:
    # Plain view: one line per network name, strongest transmitter wins.
    best = {}
    for n in sorted(nets, key=lambda r: -r["sig"]):
        best.setdefault(n["ssid"], n)
    render(sorted(best.values(), key=best_first))
else:
    # Group the radios that live in one router: the same first five address
    # bytes, the same box (see same_box), or the same name once band markers
    # are removed. Any one clue is enough.
    parent = {}

    def find(x):
        while parent.setdefault(x, x) != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    by_family = {}
    for n in nets:
        n["_base"] = n["bssid"][:14] or n["ssid"]
        find(n["_base"])
        fam = family(n["ssid"])
        if n["ssid"] != "(hidden)" and fam:
            by_family.setdefault(fam, []).append(n["_base"])
    for bases in by_family.values():
        for b in bases[1:]:
            union(bases[0], b)
    with_addr = [n for n in nets if n["bssid"]]
    for i, x in enumerate(with_addr):
        for y in with_addr[i + 1:]:
            if same_box(x["bssid"], y["bssid"]):
                union(x["_base"], y["_base"])

    groups = {}
    for n in nets:
        groups.setdefault(find(n["_base"]), []).append(n)

    # Physical boxes, for the "N access points" count: address rule only, since
    # one name can be broadcast by several boxes.
    box_parent = {}

    def box_find(x):
        while box_parent.setdefault(x, x) != x:
            x = box_parent[x]
        return x

    addrs = sorted({n["bssid"] for n in nets if len(n["bssid"]) == 17})
    for i, x in enumerate(addrs):
        for y in addrs[i + 1:]:
            if same_box(x, y):
                ra, rb = box_find(x), box_find(y)
                if ra != rb:
                    box_parent[ra] = rb
    box_of = {x: box_find(x) for x in addrs}
    for g in groups.values():
        g.sort(key=best_first)
    ordered = sorted(groups.values(), key=lambda g: best_first(g[0]))

    prev_grouped = False
    for g in ordered:
        grouped = len(g) > 1
        if grouped or prev_grouped:
            print()
        if grouped:
            names = sorted({n["ssid"] for n in g if n["ssid"] != "(hidden)"}, key=str.lower)
            boxes = len({box_of[n["bssid"]] for n in g if n["bssid"] in box_of})
            if len({family(x) for x in names}) > 1:
                names = sorted({base_name(x) for x in names}, key=str.lower)
                shown = ", ".join(names[:3]) + (f" +{len(names) - 3} more" if len(names) > 3 else "")
                label = f"{shown}  \u00b7  {len(names)} names"
            else:
                label = base_name(min(names, key=len)) if names else g[0]["ssid"]
            where = f"{boxes} access points" if boxes > 1 else "1 access point"
            radios = len({n["bssid"] for n in g if n["bssid"]}) or len(g)
            print(f"  \u250c {label}  \u00b7  {where}  \u00b7  {radios} radio{'s' if radios != 1 else ''}")
            render(g, indent="  ")
        else:
            render(g)
        prev_grouped = grouped

print("\n* = connected. Best pick: highest SNR, then strongest dBm.")
